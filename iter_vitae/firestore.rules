rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    // Alias — mesmo contrato, dois nomes para clareza nos comentários.
    function isUser(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function isDirector(directorUid) {
      return isAuth() && request.auth.uid == directorUid;
    }

    // ── Dados pessoais do dirigido — NUNCA legíveis pelo diretor ─────────────
    // A ausência de regra que concede permissão ao directorUid é a proteção real.

    match /users/{uid} {
      allow read, write: if isUser(uid);

      // Práticas: somente o próprio usuário
      match /practices/{docId} {
        allow read, write: if isUser(uid);
      }

      // Luta: somente o próprio usuário
      match /struggles/{docId} {
        allow read, write: if isUser(uid);
      }

      // Reflexões diárias: somente o próprio usuário
      match /reflections/{docId} {
        allow read, write: if isUser(uid);
      }

      // Direções espirituais (preparação, conteúdo): somente o próprio usuário
      match /directions/{docId} {
        allow read, write: if isUser(uid);
      }

      // Diário: somente o próprio usuário
      match /diary/{docId} {
        allow read, write: if isUser(uid);
      }

      // Exame diário: somente o próprio usuário
      match /exame_diario/{docId} {
        allow read, write: if isUser(uid);
      }

      // Exame de confissão: somente o próprio usuário
      match /exame_confissao/{docId} {
        allow read, write: if isUser(uid);
      }

      // Virtudes: somente o próprio usuário
      match /virtues/{docId} {
        allow read, write: if isUser(uid);
      }

      // Livros e sessões de leitura: somente o próprio usuário
      match /books/{docId} {
        allow read, write: if isUser(uid);
      }

      match /reading_sessions/{docId} {
        allow read, write: if isUser(uid);
      }

      // Meios de formação: somente o próprio usuário
      match /meios_formacao/{docId} {
        allow read, write: if isUser(uid);
      }

      // Notificações enviadas pelo diretor — o diretor escreve; o dirigido lê
      match /notifications_from_director/{notifId} {
        allow read, write: if isUser(uid);
        // O diretor só pode criar (não ler, não editar, não apagar)
        allow create: if isAuth()
          && request.resource.data.directorUid == request.auth.uid;
      }

      // Vínculo com o diretor — escrito em batch pelo diretor via linkByCode;
      // somente o próprio usuário pode ler.
      match /director/link {
        allow read: if isUser(uid);
        allow write: if isAuth();
      }
    }

    // ── Perfil e dados do diretor ─────────────────────────────────────────────

    match /directors/{directorUid} {
      // O diretor cria/lê/atualiza seu próprio perfil
      allow read, write: if isDirector(directorUid);

      // ── Vínculos com dirigidos ───────────────────────────────────────────
      match /directees/{directeeUid} {
        // O diretor gerencia seus próprios vínculos (notas privadas, etc.)
        allow read, write: if isDirector(directorUid);
        // O dirigido cria/atualiza seu próprio registro de vínculo
        allow create, update: if isAuth() && request.auth.uid == directeeUid;

        // ── Relatórios enviados pelo dirigido ────────────────────────────
        match /reports/{reportId} {
          // O dirigido envia (cria) seu próprio relatório
          allow create: if isAuth() && request.auth.uid == directeeUid;
          // O diretor vinculado lê
          allow read: if isDirector(directorUid);
        }

        // ── Propostas criadas pelo diretor ────────────────────────────────
        // O diretor cria propostas (status: pendente) e pode ler/escrever tudo.
        // O dirigido só pode atualizar o campo status (aceitar/recusar) —
        // nunca lê o conteúdo completo da proposta.
        match /proposals/{proposalId} {
          allow read, write: if isDirector(directorUid);
          allow create: if isDirector(directorUid)
                        && request.resource.data.status == 'pendente';
          allow update: if isAuth()
                        && request.auth.uid == directeeUid
                        && resource.data.status == 'pendente'
                        && (request.resource.data.status == 'aceita'
                            || request.resource.data.status == 'recusada')
                        && request.resource.data.diff(resource.data)
                               .affectedKeys().hasOnly(['status']);
        }
      }
    }

    // ── Códigos de vínculo gerados pelo diretor ───────────────────────────────
    // Campo-chave: diretorUid (sem acento — padrão do app diretor).
    // Qualquer autenticado pode GET (para validar o código ao resgatar).
    // Somente o diretor que criou pode ler a listagem completa.

    match /invite_codes/{codigo} {
      // Qualquer autenticado pode ler um código pelo ID (para validar)
      allow get: if isAuth();
      // O diretor cria seu próprio código
      allow create: if isAuth()
        && request.resource.data.diretorUid == request.auth.uid
        && request.resource.data.usado == false;
      // O diretor lê sua própria listagem
      allow list: if isAuth()
        && resource.data.diretorUid == request.auth.uid;
      // O dirigido (ou qualquer autenticado) marca o código como usado
      allow update: if isAuth()
        && resource.data.usado == false
        && request.resource.data.usado == true
        && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['usado']);
    }

    // ── Notificações do diretor para o dirigido ───────────────────────────────
    // Qualquer diretor autenticado pode criar notificações.
    // O dirigido lê e atualiza as próprias notificações (ex.: marcar como lida).

    match /notifications/{directeeUid}/inbox/{notifId} {
      allow create: if isAuth();
      allow read, update: if isUser(directeeUid);
    }

    // ── Nega tudo o que não foi explicitamente permitido acima ────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
